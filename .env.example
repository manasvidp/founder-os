# Founder OS environment variables. Copy into Railway → your service → Variables.
# Never commit real values to GitHub.

# --- Required ---
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Replace <password> with your DB user's password.
MONGO_URL=mongodb+srv://founderos:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=founder_os
# Long random string that signs your login sessions. Generate one at https://1password.com/password-generator (64 chars, no symbols).
JWT_SECRET=
# The address people use to reach the app, no trailing slash. Start with the Railway URL, change it when your domain is live.
APP_URL=https://founder-os-production.up.railway.app
# Your owner account. Only used to create it the FIRST time the app starts; after that change the password inside the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI (Chief of Staff, summaries, drafts) ---
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Email (password reset + Sunday week-ahead summary) ---
RESEND_API_KEY=
# Must use the domain you verified in Resend
EMAIL_FROM=Founder OS <noreply@yourdomain.com>

# --- Optional ---
# Timezone for "today" and the Sunday 18:00 job
APP_TIMEZONE=Europe/London
# false = nobody else can create an account (your owner account comes from ADMIN_EMAIL above)
ALLOW_SIGNUPS=false
# Google sign-in (see DEPLOY.md step 7). The Google button stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
